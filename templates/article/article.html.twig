{% extends 'base.html.twig' %}

{% block title %}{{ article.nom}}{% endblock %}

{% block body %}

<div class="detail-article">
    <div class="image-col">
        <img src="{{asset(article.photo)}}">
    </div>
    <div class="text-col">
    <h1>{{ article.nom}}</h1>
    <p class="prix">{{ article.prix}} €</p>
    <p class="description">Description:</p>
    <p class="description">{{article.descriptionLongue}}</p>
    <form action="" method="POST">
    <label for="qte">Quantité :</label>
    <input type="number" id="qte" name="qte" min="1" value="1">
    <button class="btn" type="submit">Ajouter au panier</button>
    </form>

    </div>
</div>

{% endblock %}
